cted": 0, "correct": 1, "id": 6}, {"_data": [{"type": "text", "content": "the"}], "selected": 0, "correct": 1, "id": 7}, {"_data": [{"type": "text", "content": "design"}], "selected": 0, "correct": 1, "id": 8}, {"_data": [{"type": "text", "content": "and"}], "selected": 0, "correct": 1, "id": 9}, {"_data": [{"type": "text", "content": "customers'"}], "selected": 0, "correct": 1, "id": 10}, {"_data": [{"type": "text", "content": "requirements."}], "selected": 0, "correct": 1, "id": 11}], "id": 2}, {"_data": [{"contents": [{"type": "text", "content": "Tom\u2026how to\u2026requirements. "}], "type": "question"}, {"type": "objective", "content": "secondary_1"}], "responses": [{"_data": [{"type": "text", "content": "Tom doesn't know how to set the non-functional requirements."}], "selected": 0, "correct": 0, "id": 0}, {"_data": [{"type": "text", "content": "Tom"}], "selected": 0, "correct": 1, "id": 1}, {"_data": [{"type": "text", "content": "doesn't"}], "selected": 0, "correct": 1, "id": 2}, {"_data": [{"type": "text", "content": "know"}], "selected": 0, "correct": 1, "id": 3}, {"_data": [{"type": "text", "content": "how"}], "selected": 0, "correct": 1, "id": 4}, {"_data": [{"type": "text", "content": "to"}], "selected": 0, "correct": 1, "id": 5}, {"_data": [{"type": "text", "content": "set"}], "selected": 0, "correct": 1, "id": 6}, {"_data": [{"type": "text", "content": "the"}], "selected": 0, "correct": 1, "id": 7}, {"_data": [{"type": "text", "content": "non-functional"}], "selected": 0, "correct": 1, "id": 8}, {"_data": [{"type": "text", "content": "requirements."}], "selected": 0, "correct": 1, "id": 9}], "id": 3}], "type": "WSB", "_data": [{"contents": [{"type": "text", "content": "There are many types of requirements in system engineering."}], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Activity 1"}], "type": "group"}, {"type": "feedback", "content": {"attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": "